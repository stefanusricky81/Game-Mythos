rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Players collection
    // Sensitive currencies and progression cannot be directly mutated by clients;
    // mutations must occur through authoritative Cloud Functions.
    match /players/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['uid', 'playerLevel', 'createdAt']);
      allow update: if isOwner(userId) && 
        // Direct mutation of authoritative balances is strictly prohibited
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'gold', 'mythGems', 'cardShards', 'heroShards', 'arenaPoints', 'lifetimeBattles', 'lifetimeWins'
        ]);
      allow delete: if false;

      // Cards subcollection (Server-authoritative ownership)
      match /cards/{cardId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions can grant/consume cards
      }

      // Decks subcollection (Must be validated)
      match /decks/{deckId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && request.resource.data.cardIds.size() == 20;
      }

      // Arena State subcollection
      match /arena/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false; // Rating, streaks, and attempts are server-controlled
      }

      // Arena Match History
      match /arenaMatches/{matchId} {
        allow read: if isOwner(userId);
        allow write: if false; // Match records are append-only by server
      }

      // Quests & Events progress
      match /quests/{questId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false; // Event claims must pass server validation
      }

      match /alliance/{state} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Alliances collection
    match /alliances/{allianceId} {
      allow read: if isAuthenticated();
      allow write: if false; // All mutations routed through Cloud Functions

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Competitive Seasons (Public read-only)
    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Leaderboards (Public read-only, updated server-side)
    match /leaderboards/{seasonId}/entries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // World Boss (Public read-only state, server-side damage application)
    match /worldBosses/{bossId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /contributions/{contribId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Raids (Public read-only state)
    match /raids/{raidId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /contributions/{contribId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Limited Events (Public read-only configuration)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Payment Purchases collection: Server-side authority only via Firebase Admin SDK.
    // Client SDK direct access is completely denied as an explicit backstop.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
  }
}
