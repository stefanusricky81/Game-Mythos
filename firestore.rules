rules_version = '2';

// MYTHOS Firestore rules.
//
// Principle: the game client NEVER writes Firestore. Every authoritative document (economy-adjacent
// profile, card ownership, arena state/matches, leaderboard, alliances, raid/boss state, event claims,
// reward outbox, payment ledger) is written only by Cloud Functions through the Admin SDK, which
// bypasses these rules. The client may read only what is needed to display its own state.
//
// There is deliberately no client-write rule anywhere: cosmetic profile edits, if ever added, must
// also go through a function so they can be validated (names, length, profanity) before storage.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAllianceMember(allianceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/alliances/$(allianceId)/members/$(request.auth.uid));
    }

    // ---- Player-owned, server-written: profile, collection (card ownership), arena state / matches /
    // seasons, endgame attempts, event purchases, alliance pointer, reward outbox.
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /players/{uid}/{document=**} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Public, read-only to signed-in players, server-written.
    match /leaderboards/{seasonId}/entries/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /worldBosses/{bossId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // A player's own boss contribution only.
    match /worldBosses/{bossId}/contributions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Alliance headers are browsable (join screen). The member list is visible to members only.
    match /alliances/{allianceId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /alliances/{allianceId}/members/{uid} {
      allow read: if isAllianceMember(allianceId);
      allow write: if false;
    }

    // ---- Server-only. Explicit denies document intent and survive a future wildcard being added.
    // Payment ledger: written/read only by verifyPlayPurchase / getPlayerEntitlements (Admin SDK).
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /gameSessions/{sessionId} {
      allow read, write: if false;
    }
    match /idempotency/{key} {
      allow read, write: if false;
    }
    match /rateLimits/{key} {
      allow read, write: if false;
    }
    match /allianceNames/{name} {
      allow read, write: if false;
    }
    match /allianceRaids/{key} {
      allow read, write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
